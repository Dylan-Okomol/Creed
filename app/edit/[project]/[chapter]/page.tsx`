'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';

export default function WritingStudioPage({ params }: { params: { project: string; chapter: string } }) {
  const [content, setContent] = useState('');
  const [isSaving, setIsSaving] = useState(false);
  const router = useRouter();

  useEffect(() => {
    // Authentication Check
    const token = localStorage.getItem('creed_admin_token');
    if (!token) {
      router.push('/admin-access');
    }

    // Load initial content
    async function loadContent() {
      try {
        const res = await fetch(`/api/content/${params.project}/${params.chapter}`);
        const data = await res.json();
        if (data.content) {
          setContent(data.content);
        }
      } catch (e) {
        console.error('Failed to load content', e);
      }
    }
    loadContent();
  }, [params, router]);

  const handleSave = async () => {
    setIsSaving(true);
    try {
      const response = await fetch('/api/commit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          project: params.project,
          chapter: params.chapter,
          content: content,
        }),
      });

      if (response.ok) {
        alert('Changes committed to GitHub successfully!');
      } else {
        const err = await response.text();
        alert(`Error saving: ${err}`);
      }
    } catch (e) {
      alert('Network error occurred while saving.');
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <main className="min-h-screen bg-zinc-900 text-zinc-100 flex flex-col">
      {/* Toolbar */}
      <header className="p-4 border-b border-zinc-800 bg-zinc-950 flex justify-between items-center sticky top-0 z-10">
        <div className="flex items-center gap-4">
          <Link href="/library" className="text-sm text-zinc-400 hover:text-white">
            ← Exit Studio
          </Link>
          <span className="text-xs text-zinc-600 font-mono">
            {params.project} / {params.chapter}
          </span>
        </div>
        <button
          onClick={handleSave}
          disabled={isSaving}
          className={`px-6 py-2 rounded-full font-medium transition-all ${
            isSaving
              ? 'bg-zinc-800 text-zinc-500 cursor-not-allowed'
              : 'bg-white text-black hover:bg-zinc-200'
          }`}
        >
          {isSaving ? 'Committing...' : 'Save Changes'}
        </button>
      </header>

      {/* Editor Area */}
      <div className="flex-1 p-6 flex justify-center">
        <div className="max-w-4xl w-full h-full flex flex-col gap-4">
          <textarea
            value={content}
            onChange={(e) => setContent(e.target.value)}
            className="flex-1 w-full p-8 bg-zinc-950 border border-zinc-800 rounded-xl focus:outline-none focus:border-zinc-600 transition-colors font-mono text-lg leading-relaxed resize-none"
            placeholder="Write your knowledge node here..."
          />
          <p className="text-zinc-500 text-xs text-right italic">
            Supports Markdown. Content is committed directly to GitHub.
          </p>
        </div>
      </div>
    </main>
  );
}
